@page
@model MyDashboardApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
  ViewData["Title"] = "Stitch Design — Dashboard";
  Layout = "Shared/_Layout"; // Use the shared layout
}

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Project Dashboard</h1>
    <p class="text-muted">Analyze SQL database lineage, SSIS data mapping, and .NET integrations.</p>
  </div>
  <form method="post" class="flex gap-2">
    <input asp-for="NewConn.Source" class="rounded border p-2 text-black" placeholder="Source" />
    <input asp-for="NewConn.Destination" class="rounded border p-2 text-black" placeholder="Destination" />
    <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-white font-bold">Submit</button>
  </form>
</div>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div class="rounded border border-dashboard p-6 bg-dashboard">
    <p class="text-white">Total Connections</p>
    <p class="text-3xl text-white">@Model.AllConns.Count</p>
  </div>
  <div class="rounded border border-dashboard p-6 bg-dashboard">
    <p class="text-white">Total Tables Analysed</p>
    <p class="text-3xl text-white">@Model.TotalTablesAnalysed</p>
  </div>
  <div class="rounded border border-dashboard p-6 bg-dashboard">
    <p class="text-white">Client PII Tables</p>
    <p class="text-3xl text-white">@Model.ClientPIITables</p>
  </div>
</div>

<section class="mt-8">
  <h2 class="text-xl font-bold text-white mb-4">Charts</h2>
  <div class="rounded border border-dashboard p-6 bg-dashboard h-64 flex items-center justify-center">
    <p class="text-muted">Chart placeholder</p>
  </div>
</section>

<section class="mt-8 overflow-x-auto">
  <table class="min-w-full bg-dashboard rounded overflow-hidden">
    <thead class="bg-panel">
      <tr>
        <th class="px-4 py-2 text-white">Source</th>
        <th class="px-4 py-2 text-white">Destination</th>
        <th class="px-4 py-2 text-white">Created At</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var conn in Model.AllConns)
      {
        <tr class="border-t border-dashboard">
          <td class="px-4 py-2 text-white">@conn.Source</td>
          <td class="px-4 py-2 text-white">@conn.Destination</td>
          <td class="px-4 py-2 text-muted">@conn.CreatedAt.ToLocalTime().ToString("g")</td>
        </tr>
      }
    </tbody>
  </table>
</section>
